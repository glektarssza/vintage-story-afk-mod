<?xml version="1.0" encoding="UTF-8"?>
<Project Sdk="Microsoft.NET.Sdk" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup Label="Project Properties">
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <TargetFramework>net10.0</TargetFramework>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>bin/$(Configuration)/Mods/mod</OutputPath>
        <RootNamespace>GlekTarssza.VintageStory.AFKMod</RootNamespace>
        <ProjectDir>$(MSBuildProjectDirectory)/src/</ProjectDir>
        <ImplicitUsings>disable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <!-- HACK: Temporarily disable IDE0005 to work around a GitHub Actions issue -->
        <NoWarn>IDE0005</NoWarn>
        <UserPropsPath Condition="$(UserPropsPath) == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($(MSBuildProjectDirectory), '../user.props'))))</UserPropsPath>
    </PropertyGroup>
    <PropertyGroup Label="Assembly Properties">
        <VersionPrefix>0.1.0</VersionPrefix>
        <VersionSuffix>$(Configuration)</VersionSuffix>
        <Title>G'lek's Vintage Story AFK Mod</Title>
        <Product>G'lek's Vintage Story AFK Mod</Product>
        <Description>A mod for Vintage Story that lets players go AFK and preserves their health/hunger while they are plus makes them immune to targeting/damage.</Description>
        <Authors>G'lek Tarssza</Authors>
        <Copyright>Copyright (c) 2026 G'lek Tarssza</Copyright>
    </PropertyGroup>
    <Import Condition="Exists($(UserPropsPath))" Project="$(UserPropsPath)" />
    <ItemGroup Label="Implicit Usings">
        <Using Include="System" />
    </ItemGroup>
    <ItemGroup Label="Dependencies">
        <Reference Include="VintagestoryAPI">
            <HintPath>$(VintageStoryInstallPath)/VintagestoryAPI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="VSSurvivalMod">
            <HintPath>$(VintageStoryInstallPath)/Mods/VSSurvivalMod.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VSEssentials">
            <HintPath>$(VintageStoryInstallPath)/Mods/VSEssentials.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(VintageStoryInstallPath)/Lib/Newtonsoft.Json.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(VintageStoryInstallPath)/Lib/0Harmony.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VintagestoryLib">
            <HintPath>$(VintageStoryInstallPath)/VintagestoryLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup Label="Mod Content">
        <Content Include="modinfo.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="modicon.png" Condition="Exists('modicon.png')">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <Target Name="DebugVars">
        <Message Importance="High" Text="UserPropsPath = $(UserPropsPath)" />
        <Message Importance="High" Text="Exists(UserPropsPath) = $([System.IO.Path]::Exists($(UserPropsPath)))" />
        <Message Importance="High" Text="VintageStoryInstallPath = $(VintageStoryInstallPath)" />
    </Target>
</Project>
